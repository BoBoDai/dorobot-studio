# Build artifacts
**/target/
**/*.rs.bk
**/out/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Dataset files (large binary data)
/dataset/*
# Allow specific datasets as submodules
!/dataset/aloha_mobile_cabinet

# Debug logs
*.log
/tmp/

# Cargo lock for libraries (optional, keep for binaries)
# Cargo.lock

# VQA capture output (goldens are tracked, transient shots are not)
tools/vqa/out/
dataset/

# Robot meshes are fetched, not committed: see tools/fetch_robot_meshes.py
data/g1/meshes/

# Tool caches
**/.lafan1-cache/
.venv-capture/

# Private local configuration, credentials and generated data
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
*.local.json
.venv*/
__pycache__/
*.pyc
*.log
/datasets/
/recordings/
/docs/completion-evidence/
/docs/audit-*/
/docs/verification-*.json

# Local Makepad runner state
/.makepad/
/.makepad-jit/

# Release staging and distributables
/dist/
